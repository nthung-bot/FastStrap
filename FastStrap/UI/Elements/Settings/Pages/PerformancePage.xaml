<ui:UiPage x:Class="FastStrap.UI.Elements.Settings.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:FastStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:FastStrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance Type=models:PerformanceViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="PerformancePage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" Text="Configure performance settings for Roblox." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <controls:OptionControl
            Header="High process priority"
            Description="Launch Roblox with high CPU priority. This can improve frame times and reduce stutters.">
            <ui:ToggleSwitch IsChecked="{Binding RobloxHighPriority, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Close background apps"
            Description="Close other running apps before launching Roblox to free up RAM and CPU.">
            <ui:ToggleSwitch IsChecked="{Binding CloseBackgroundApps, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Use DNS 1.1.1.1 (Cloudflare)"
            Description="Switch your internet DNS to Cloudflare (1.1.1.1) when launching Roblox for faster lookups. Requires administrator permission.">
            <ui:ToggleSwitch IsChecked="{Binding UseCloudflareDns, Mode=TwoWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
